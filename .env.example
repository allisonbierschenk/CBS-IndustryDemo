# ─────────────────────────────────────────────────────────────────────────────
# Apex Consulting Client Value Intelligence Portal — environment
# Copy to .env and fill in. NEVER commit .env (it holds the connected app secret).
# ─────────────────────────────────────────────────────────────────────────────

# Tableau Cloud pod URL (no trailing slash) and site content URL
# e.g. https://prod-useast-b.online.tableau.com   and   my-site
TABLEAU_SERVER=https://YOUR-POD.online.tableau.com
TABLEAU_SITE=your-site-content-url

# Connected App (Direct Trust) — Settings > Connected Apps > (your app)
CONNECTED_APP_CLIENT_ID=
CONNECTED_APP_SECRET_ID=
CONNECTED_APP_SECRET_VALUE=

# JWT lifetime in seconds (Tableau maximum is 600 = 10 minutes)
JWT_TTL_SECONDS=300

# Name of the user attribute claim injected into every JWT.
# Must EXACTLY match the name used in USERATTRIBUTE / USERATTRIBUTEINCLUDES (case sensitive).
USER_ATTRIBUTE_CLAIM=client name

# Portal session signing secret (any long random string: `openssl rand -hex 32`).
# Optional locally (a temporary one is generated); required when NODE_ENV=production.
SESSION_SECRET=

# Port and environment
PORT=3000
NODE_ENV=development
